# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://interview:interview@localhost:5432/interview_helper

# --- Model provider ---------------------------------------------------------
# "bedrock" routes live sessions through AWS so promotional credits absorb them.
# "anthropic" is the escape hatch; it bills the Anthropic account directly.
MODEL_PROVIDER=bedrock

# Bedrock ids for current models are CROSS-REGION INFERENCE PROFILES: `us.` prefixed, and
# often dated and versioned. Measured 2026-08-20 — the undecorated ids this file used to
# carry (anthropic.claude-opus-5) fail with "does not exist" or "on-demand throughput isn't
# supported, retry with an inference profile".
AWS_REGION=us-east-2

# All four point at the one model this AWS account can reach today. The intended routing is
# Opus 5 for planning and grading, Sonnet 5 for interviewing turns, Haiku 4.5 for utility
# work (docs/ARCHITECTURE.md); those ids answer "not available for this account" until
# Bedrock model access is granted — see docs/COST.md, "Getting the routing table back".
MODEL_PLANNER=us.anthropic.claude-sonnet-4-6
MODEL_INTERVIEWER=us.anthropic.claude-sonnet-4-6
MODEL_GRADER=us.anthropic.claude-sonnet-4-6
MODEL_UTILITY=us.anthropic.claude-sonnet-4-6

# Anthropic direct (only needed when MODEL_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=

# --- Auth (docs/API.md) ------------------------------------------------------
# Single user: GitHub OAuth in, a signed session cookie afterwards. Everything under
# /api/v1 requires that cookie; /health and /auth/* do not.
#
# SESSION_SECRET signs it. Without one the API answers 503 rather than running open.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# SESSION_SECRET=

# From the GitHub OAuth app (Settings -> Developer settings -> OAuth Apps). Its callback
# URL must match GITHUB_REDIRECT_URI exactly.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# The one account allowed to log in — your numeric id, not your handle:
#   curl -s https://api.github.com/users/<handle> | jq .id
# Unset means nobody can log in, which is the safe direction to fail.
# GITHUB_ALLOWED_ID=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback

# Set false only for plain-http localhost. True everywhere a browser will see HTTPS.
COOKIE_SECURE=true

# --- Cost guardrails --------------------------------------------------------
# Enforced: `api.llm` checks both before every model call and refuses with 429 rather than
# downgrading the model or truncating the context (docs/COST.md, "Hard budgets"). The daily
# limit resets at UTC midnight. `GET /api/v1/costs/budget` reports what is left.
MAX_TOKENS_PER_SESSION=400000
MAX_TOKENS_PER_DAY=3000000

# --- Executor ---------------------------------------------------------------
EXECUTOR_URL=http://localhost:8081
EXECUTOR_WALL_MS=5000
EXECUTOR_MEMORY_MB=256

# --- Voice (phase 7) --------------------------------------------------------
# VAPI_API_KEY=
# VAPI_WEBHOOK_SECRET=
