# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://interview:interview@localhost:5432/interview_helper

# --- Model provider ---------------------------------------------------------
# "bedrock" routes live sessions through AWS so promotional credits absorb them.
# "anthropic" is the escape hatch; it bills the Anthropic account directly.
MODEL_PROVIDER=bedrock

# Bedrock (model IDs carry the anthropic. prefix on this provider)
AWS_REGION=us-east-1
MODEL_PLANNER=anthropic.claude-opus-5
MODEL_INTERVIEWER=anthropic.claude-sonnet-5
MODEL_GRADER=anthropic.claude-opus-5
MODEL_UTILITY=anthropic.claude-haiku-4-5

# Anthropic direct (only needed when MODEL_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=

# --- Auth (docs/API.md) ------------------------------------------------------
# Single user: GitHub OAuth in, a signed session cookie afterwards. Everything under
# /api/v1 requires that cookie; /health and /auth/* do not.
#
# SESSION_SECRET signs it. Without one the API answers 503 rather than running open.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# SESSION_SECRET=

# From the GitHub OAuth app (Settings -> Developer settings -> OAuth Apps). Its callback
# URL must match GITHUB_REDIRECT_URI exactly.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# The one account allowed to log in — your numeric id, not your handle:
#   curl -s https://api.github.com/users/<handle> | jq .id
# Unset means nobody can log in, which is the safe direction to fail.
# GITHUB_ALLOWED_ID=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback

# Set false only for plain-http localhost. True everywhere a browser will see HTTPS.
COOKIE_SECURE=true

# --- Cost guardrails --------------------------------------------------------
# NOT YET ENFORCED — read into Settings and consumed by nothing. No middleware exists and
# no model call has ever been made. The intent is that a request is refused rather than
# allowed to overspend; see docs/COST.md, "Hard budgets".
MAX_TOKENS_PER_SESSION=400000
MAX_TOKENS_PER_DAY=3000000

# --- Executor ---------------------------------------------------------------
EXECUTOR_URL=http://localhost:8081
EXECUTOR_WALL_MS=5000
EXECUTOR_MEMORY_MB=256

# --- Voice (phase 7) --------------------------------------------------------
# VAPI_API_KEY=
# VAPI_WEBHOOK_SECRET=
