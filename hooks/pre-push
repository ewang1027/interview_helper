#!/usr/bin/env bash
# Installed via: git config core.hooksPath hooks (make setup)
#
# Two gates, both cheap, both guarding rules that are otherwise upheld by memory alone:
# nothing secret leaves the machine (docs/SECURITY.md — the repo is public), and nothing
# undocumented lands on the remote (CLAUDE.md — docs travel with the code).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# git feeds a pre-push hook one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# A sha of all zeros means "does not exist": on the local side the ref is being deleted,
# on the remote side the branch is new and every local commit is about to be published.
remote=${1:-origin}
ranges=()
while read -r local_ref local_sha _remote_ref remote_sha; do
  if [[ -z ${local_ref:-} || $local_ref != refs/heads/* ]]; then
    continue  # tags and notes carry no work of their own
  fi
  if [[ $local_sha =~ ^0+$ ]]; then
    continue  # deleting a branch
  fi
  if [[ $remote_sha =~ ^0+$ ]]; then
    ranges+=("$local_sha --not --remotes=$remote")
  else
    ranges+=("$remote_sha..$local_sha")
  fi
done

# The secret scan runs *after* the ranges are computed, so it can read what is actually
# being published rather than only what happens to be in the working tree. Paste a key,
# commit, `git rm` it, commit the fix, push — the tree is clean at this moment and both
# commits reach a public remote. With no ranges (a tag push, a deletion) it falls back to
# the working-tree scan, which is still better than nothing.
# `"${ranges[@]}"` on an empty array is an unbound-variable abort under `set -u` on the
# bash 3.2 that ships with macOS, so the empty case is spelled out rather than relied on.
if [[ ${#ranges[@]} -gt 0 ]]; then
  bash scripts/secret_scan.sh "${ranges[@]}"
  bash scripts/docs_with_code.sh "${ranges[@]}"
else
  bash scripts/secret_scan.sh
fi
